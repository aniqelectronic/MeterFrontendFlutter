  "wildWestTitle": "Wild West Cowboy Indoor Theme Park",
  "wildWestDesc": "Fun indoor cowboy themed amusement park for all ages.",
  "wildWestFull": "Wild West Cowboy Indoor Theme Park is a unique indoor family amusement centre located in Dataran Segar, Port Dickson. It features colourful rides, interactive arcade games, thrilling 5D and 7D motion cinema experiences, escape rooms with themed puzzles, a variety of attractions such as Rodeo Bull rides and a game centre, as well as a cowboy café and souvenir shop — offering fun for both kids and adults throughout the year. Visitors can enjoy exciting attractions and immersive themes under one roof.",

  "wetWorldTitle": "Wet World Resort Air Panas Pedas",
  "wetWorldDesc": "Waterpark & natural hot springs destination with slides and relax pools.",
  "wetWorldFull": "Wet World Resort Air Panas Pedas is a popular water theme park and hot spring attraction in Pedas, Negeri Sembilan. The park combines thrilling water rides and slides with soothing hot spring pools that are naturally heated and rich in mineral waters — believed to offer therapeutic benefits such as easing joint pains and relaxing muscles. The resort offers rides suitable for families as well as natural hot springs for visitors seeking relaxation and leisure.",

  "tnKenaboiTitle": "Taman Negeri Kenaboi",
  "tnKenaboiDesc": "State forest park with rich biodiversity and nature trails.",
  "tnKenaboiFull": "Taman Negeri Kenaboi is a protected forest reserve known for its lush rainforest habitat, wildlife, and outdoor trails. Visitors can explore scenic walks, observe diverse plant and animal life, and enjoy nature photography.",

  "eduEcoSungaiMenyalaTitle": "Pusat Edu-Ecotourism Sungai Menyala",
  "eduEcoSungaiMenyalaDesc": "Educational eco-tourism centre by the river.",
  "eduEcoSungaiMenyalaFull": "Pusat Edu-Ecotourism Sungai Menyala is an eco‑centric destination dedicated to conservation education along the Sungai Menyala river.",

  "hutanRecTanjungTuanTitle": "Hutan Rekreasi Tanjung Tuan",
  "hutanRecTanjungTuanDesc": "Coastal forest park known for bird watching and nature trails.",
  "hutanRecTanjungTuanFull": "Hutan Rekreasi Tanjung Tuan is a scenic coastal forest park offering nature trails, headland views and seasonal bird migration observation — especially raptors that pass through on annual routes.",

  "serembanHillParkTitle": "S2 Seremban Hill Park",
  "serembanHillParkDesc": "Hill park with walking paths and scenic views.",
  "serembanHillParkFull": "S2 Seremban Hill Park is a local recreational hill park featuring walking trails, lookout points with panoramic views of Seremban and surrounding valleys.",

  "pIkanHiasanPDTitle": "Pusat Ikan Hiasan Port Dickson",
  "pIkanHiasanPDDesc": "Aquarium showcasing marine ornamental species.",
  "pIkanHiasanPDFull": "Pusat Ikan Hiasan Port Dickson showcases a variety of coastal and marine ornamental fish species in well‑maintained aquarium exhibits — ideal for families and educational visits.",

  "airTerjunLataKijangTitle": "Air Terjun Lata Kijang",
  "airTerjunLataKijangDesc": "Picturesque waterfall in a forest setting.",
  "airTerjunLataKijangFull": "Air Terjun Lata Kijang is a natural waterfall set amid lush forest — a refreshing destination for hikers, picnics and nature lovers.",

  "hutanLipurJeramTengkekTitle": "Hutan Lipur Jeram Tengkek",
  "hutanLipurJeramTengkekDesc": "Natural recreational forest with rapids and greenery.",
  "hutanLipurJeramTengkekFull": "Hutan Lipur Jeram Tengkek is a natural forest recreation area where visitors can enjoy shaded trails, river rapids and lush greenery, perfect for outdoor outings. ",

  "puncakBukitBatuPutihTitle": "Puncak Bukit Batu Putih",
  "puncakBukitBatuPutihDesc": "Hilltop destination with scenic views.",
  "puncakBukitBatuPutihFull": "Puncak Bukit Batu Putih offers visitors a scenic hilltop vantage point, ideal for hiking, photography and panoramic views of the surrounding landscapes. ",

  "muziumAstanaRajaMelawarTitle": "Muzium Replika Astana Raja Melawar",
