  "aFamosaFull": "ஏ ஃபேமோசா 1511 இல் கட்டப்பட்ட போர்த்துகீசிய கோட்டையாகும். இது ஆசியாவின் பழமையான ஐரோப்பிய கட்டிடக்கலை இடிபாடாகும்.",

  "perigiHangTuahDesc": "மாவீரன் ஹாங் துவா கிணறு.",
  "perigiHangTuahFull": "ஹாங் துவா கிணறு மாவீரன் ஹாங் துவா பயன்படுத்திய வரலாற்று கிணறு என நம்பப்படுகிறது.",

  "istanaKesultananDesc": "மலாக்கா சுல்தானக அரண்மனை மாதிரி.",
  "istanaKesultananFull": "இந்த அருங்காட்சியகம் மலாக்கா சுல்தானக அரண்மனையின் மர மாதிரி அருங்காட்சியகமாகும்.",

  "babaNyonyaDesc": "பாபா நியோன்யா பாரம்பரியம்.",
  "babaNyonyaFull": "பாபா நியோன்யா அருங்காட்சியகம் டச்சு-சீன சமூகத்தின் வரலாற்றைக் காட்டும் இடமாகும்.",

  "galeriWarisanDesc": "பாரம்பரிய கைவினைப்பொருட்கள்.",
  "galeriWarisanFull": "மலாக்கா பாரம்பரிய கேலரி உள்ளூர் கைவினைப்பொருட்கள் மற்றும் கலைகளைக் காட்டுகிறது.",

  "chengHoDesc": "சாங் ஹோ அருங்காட்சியகம்.",
  "chengHoFull": "சீனப் பயணி சாங் ஹோ மலாக்காவுக்கு வந்த வரலாற்றைக் கூறும் அருங்காட்சியகமாகும்.",

  "samuderaDesc": "கடல்சார் வணிக வரலாறு.",
  "samuderaFull": "கப்பல் வடிவ அருங்காட்சியகம் மலாக்காவின் கடல்சார் வரலாற்றைக் காட்டுகிறது.",

  "middelburgDesc": "போர்த்துகீசிய கோட்டை பகுதி.",
  "middelburgFull": "மிடல்பெர்க் கோட்டையின் மிச்சமிருக்கும் வரலாற்றுப் பகுதியாகும்.",

  "ethnoDesc": "கலாச்சார தொல்பொருட்கள்.",
  "ethnoFull": "மலாக்காவின் கலாச்சாரப் பன்முகத்தன்மையைக் காட்டும் அருங்காட்சியகமாகும்.",

  "zeroKmDesc": "மலாக்கா 0 கி.மீ சின்னம்.",
  "zeroKmFull": "மலாக்காவின் மையப் புள்ளியைக் குறிக்கும் வரலாற்றுச் சின்னமாகும்.",

  "stPaulDesc": "செயிண்ட் பால் தேவாலயம்.",
  "stPaulFull": "1521 இல் கட்டப்பட்ட பழமையான போர்த்துகீசிய தேவாலயமாகும்.",

  "hangJebatDesc": "ஹாங் ஜெபாட் நினைவிடம்.",
  "hangJebatFull": "ஹாங் ஜெபாட்டின் வீரத்தை நினைவுகூரும் கல்லறைத் தளமாகும்.",

  "zooDesc": "மலாக்கா விலங்கியல் பூங்கா.",
  "zooFull": "பல்வேறு விலங்குகளைக் கொண்ட குடும்ப பொழுதுபோக்கு பூங்காவாகும்.",

  "riverDesc": "மலாக்கா ஆற்றுப் படகுச் சவாரி.",
  "riverFull": "மலாக்கா ஆற்றின் வழியே நகரத்தின் அழகைக் காணும் படகுச் சவாரியாகும்.",

  "crocDesc": "முதலை மற்றும் ஊர்வன பூங்கா.",
  "crocFull": "முதலைகள் மற்றும் ஊர்வனவற்றைக் கொண்ட பொழுதுபோக்கு பூங்காவாகும்.",

  "magicDesc": "3D மாயத்தோற்ற அருங்காட்சியகம்.",
  "magicFull": "3D ஓவியங்களுடன் விசித்திரமான புகைப்படங்கள் எடுக்கும் இடமாகும்.",

  "breakoutDesc": "புதிர் விளையாட்டு அறை (Escape Room).",
  "breakoutFull": "குடும்பங்கள் மற்றும் நண்பர்களுக்கான புதிர் விளையாட்டு அறையாகும்.",

  "waterDesc": "ஏ ஃபேமோசா நீர் தீம் பார்க்.",
  "waterFull": "அனைத்து வயதினருக்குமான நீர் விளையாட்டுகள் கொண்ட பூங்காவாகும்.",

  "mocityDesc": "சிறார் பொழுதுபோக்கு பூங்கா.",
  "mocityFull": "குழந்தைகளுக்கான விளையாட்டுகள் மற்றும் செயல்பாடுகளாகும்.",

  "wonderlandDesc": "மலாக்கா வொண்டர்லேண்ட் நீர் பூங்கா.",
  "wonderlandFull": "நீர் விளையாட்டுகள் நிறைந்த பொழுதுபோக்கு பூங்காவாகும்.",

  "wonderparkDesc": "வொண்டர்பார்க் பொழுதுபோக்கு மையம்.",
  "wonderparkFull": "அனைவருக்குமான உட்புற பொழுதுபோக்கு மையமாகும்.",

  "ukfunDesc": "குடும்ப பொழுதுபோக்கு பூங்கா.",
  "ukfunFull": "சவாரிகள் கொண்ட குடும்ப பூங்காவாகும்.",

  "safariDesc": "சஃபாரி வொண்டர்லேண்ட்.",
  "safariFull": "விலங்குகளை அருகில் பார்க்கும் சஃபாரி பூங்காவாகும்.",

  "asahanDesc": "அசாஹான் நீர் தீம் பார்க்.",
  "asahanFull": "நீர் சறுக்கு விளையாட்டுகள் கொண்ட பூங்காவாகும்.",

  "bayouDesc": "பாயு லாகூன் நீர் பூங்கா.",
  "bayouFull": "நீச்சல் குளங்கள் கொண்ட ஓய்வு விடுதி நீர் பூங்காவாகும்.",

  "babaKayaDesc": "பாபா நியோன்யா உணவு.",
  "babaKayaFull": "பாரம்பரிய பாபா நியோன்யா உணவுகளை வழங்கும் உணவகமாகும்.",

  "asamSeleraDesc": "ஆசம் பெதாஸ் (Asam Pedas).",
  "asamSeleraFull": "மலாக்காவின் புகழ்பெற்ற கார புளிப்பு மீன் குழம்பு உணவகமாகும்.",

  "atlanticDesc": "நவீன நியோன்யா உணவு.",
  "atlanticFull": "பாரம்பரிய சூழலில் நவீன நியோன்யா உணவுகளை வழங்குகிறது.",

  "cendolDesc": "பாரம்பரிய மலாக்கா செண்டோல்.",
  "cendolFull": "சுவையான குலா மலாக்கா செண்டோல் கடையாகும்.",

  "asamOrangDesc": "வீட்டு முறை ஆசம் பெதாஸ்.",
  "asamOrangFull": "அமைதியான சூழலில் வீட்டு முறை ஆசம் பெதாஸ் உணவகமாகும்.",

  "atasDesc": "ஆற்றங்கரை சொகுசு உணவகம்.",
  "atasFull": "மலாக்கா ஆற்றங்கரையில் உள்ள சொகுசு உணவகமாகும்.",

  "rooftopDesc": "மாடி கஃபே உணவகம் (Rooftop).",
  "rooftopFull": "நகரக் காட்சியுடன் கூடிய மேற்கத்திய மற்றும் உள்ளூர் உணவு கஃபே.",

  "chefWanDesc": "செஃப் வான் நியோன்யா கஃபே.",
  "chefWanFull": "பிரபல செஃப் வானின் பாரம்பரிய மலேசிய உணவகமாகும்.",

  "calantheDesc": "13 மாநிலங்களின் காஃபே.",
  "calantheFull": "மலேசியாவின் 13 மாநிலங்களின் காபியை வழங்கும் கலைக் காஃபே.",

  "papayunDesc": "ஆற்றங்கரை பாரம்பரிய உணவகம்.",
  "papayunFull": "ஆற்றங்கரையில் அமைதியான சூழலில் உள்ளூர் உணவுகளை வழங்குகிறது.",

  "kamparExplorationTitle": "காம்பார் ஆய்வு",

  "kintaTinDesc": "கிந்தா ஈயச் சுரங்க அருங்காட்சியகம்.",
  "kintaTinFull": "கிந்தா பள்ளத்தாக்கின் ஈயச் சுரங்க வரலாற்றைக் காட்டும் அருங்காட்சியகமாகும்.",

  "chimneyDesc": "ஜப்பானிய கார்பைடு புகைபோக்கி.",
  "chimneyFull": "காம்பாரின் ஆரம்பகால தொழில்துறை வரலாற்று அமைப்பாகும்.",

  "kellieDesc": "கெல்லி அரண்மனை (Kellie's Castle).",
  "kellieFull": "பேராக்கில் உள்ள புகழ்பெற்ற முடிவுறாத வரலாற்று அரண்மனையாகும்.",

  "greenRidgeDesc": "இரண்டாம் உலகப் போர் பகுதி.",
  "greenRidgeFull": "இரண்டாம் உலகப் போரின் காம்பார் போர் நடந்த இடமாகும்.",

  "clockDesc": "காம்பார் மணி கோபுரம்.",
  "clockFull": "நகரத்தின் முக்கிய அடையாள மணி கோபுரமாகும்.",

  "gravelDesc": "கரேவல் பம்ப் அருங்காட்சியகம்.",
  "gravelFull": "ஈயம் தோண்டியெடுக்கும் முறையைக் காட்டும் அருங்காட்சியகமாகும்.",

  "westLakeDesc": "மேற்கு ஏரி பொழுதுபோக்கு பகுதி.",
  "westLakeFull": "சூரிய அஸ்தமனத்தைப் பார்க்க ஏற்ற அழகிய ஏரிப் பகுதியாகும்.",

  "ilhamDesc": "இல்ஹாம் கலை தெரு ஓவியங்கள்.",
  "ilhamFull": "உள்ளூர் கலாச்சாரத்தைக் காட்டும் சுவரோவியங்களாகும்.",

  "pipelineDesc": "கோபெங் வரலாற்று பைப் பாலம்.",
  "pipelineFull": "புகைப்படம் எடுக்க ஏற்ற பழமையான குழாய் பாலமாகும்.",

  "tempurungDesc": "தெம்பூரோங் குகை (Gua Tempurung).",
  "tempurungFull": "மலேசியாவின் மிகநீளமான அழகான சுண்ணாம்பு குகையாகும்.",

  "heritageDesc": "கோபெங் பாரம்பரிய இல்லம்.",
  "heritageFull": "பழங்காலப் பொருட்கள் மற்றும் கட்டிடக்கலையைப் பாதுகாக்கும் இல்லமாகும்.",

  "saluDesc": "சுங்கை சாலு மழைக்காடு.",
  "saluFull": "காட்டு நடைபயிற்சிக்கு ஏற்ற மழைக்காட்டுப் பகுதியாகும்.",

  "kanduDesc": "கண்டு குகை சாகசம்.",
  "kanduFull": "குகை ஆய்வு மற்றும் முகாம்களுக்குப் புகழ்பெற்ற இடமாகும்.",

  "agaciaDesc": "ஐரோப்பிய பாணி நகரம்.",
  "agaciaFull": "ஐரோப்பிய பாணி வண்ணமயமான கட்டிடங்கள் கொண்ட பகுதியாகும்.",

  "gaharuDesc": "கஹாரு தேயிலைத் தோட்டம்.",
  "gaharuFull": "குன்று காட்சியைக் கொண்ட கஹாரு மரத் தோட்டமாகும்.",

  "refarmDesc": "ரீஃபார்ம் பண்ணை பூங்கா.",
  "refarmFull": "பண்ணை விலங்குகள் மற்றும் மிதிவண்டி ஓட்ட ஏற்ற பூங்காவாகும்.",

  "sahomDesc": "சஹோம் வேலி ரிசார்ட்.",
  "sahomFull": "இயற்கை சூழல் கிராம பொழுதுபோக்கு விடுதியாகும்.",

  "zaharaDesc": "ஜாஹாரா பூங்கா.",
  "zaharaFull": "புகைப்படங்கள் எடுக்க ஏற்ற அழகான நிலப்பரப்பு பூங்காவாகும்.",

  "buncitDesc": "புன்சிட் கஃபே.",
  "buncitFull": "புகைபிடித்த இறைச்சி மற்றும் மேற்கத்திய உணவகமாகும்.",

  "lacottageDesc": "ஆற்றுக்குள் உணவருந்தும் கஃபே.",
  "lacottageFull": "ஆற்று நீரில் அமர்ந்து உணவருந்தும் விசித்திர அனுபவமாகும்.",

  "kelapaDesc": "தேங்காய் இனிப்புகள்.",
  "kelapaFull": "தேங்காய் பானங்கள் மற்றும் சுவையான இனிப்புகளாகும்.",

  "nasi786Desc": "நசி கந்தார் 786.",
  "nasi786Full": "கெட்டியான கறி குழம்புகளுக்குப் பெயர் பெற்ற நசி கந்தார் உணவகமாகும்.",

  "adilyDesc": "ஆதிலி உணவகம்.",
